import os
from dotenv import load_dotenv

load_dotenv()

# Use C:\poputka-ai-data to avoid OneDrive cyrillic path issues with SQLite
DB_DIR = r'C:\poputka-ai-data'
os.makedirs(DB_DIR, exist_ok=True)

SQLALCHEMY_DATABASE_URI = os.getenv('DATABASE_URI', f'sqlite:///{DB_DIR}/poputka.db')
# SQLite connect args for Windows compatibility
SQLALCHEMY_ENGINE_OPTIONS = {
    'connect_args': {'check_same_thread': False} if os.name == 'nt' else {}
}
SQLALCHEMY_TRACK_MODIFICATIONS = False

SECRET_KEY = os.getenv('SECRET_KEY', 'dev-secret-key-change-in-production')

MOCK_2GIS = os.getenv('MOCK_2GIS', 'true').lower() == 'true'
TWOGIS_API_KEY = os.getenv('TWOGIS_API_KEY', '')

MOCK_EMAIL = os.getenv('MOCK_EMAIL', 'true').lower() == 'true'
RUSENDER_API_KEY = os.getenv('RUSENDER_API_KEY', '')

# If True, allow any email domain (not just @stud.urfu.ru)
ALLOW_ANY_EMAIL = os.getenv('ALLOW_ANY_EMAIL', 'false').lower() == 'true'

OPENAI_API_KEY = os.getenv('OPENAI_API_KEY', '')

