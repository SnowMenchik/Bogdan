# Flask secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Database (SQLite by default)
DATABASE_URI=sqlite:///data/poputka.db

# 2GIS API (optional, mock by default)
MOCK_2GIS=true
TWOGIS_API_KEY=

# Email service (optional, mock by default)
MOCK_EMAIL=true
RUSENDER_API_KEY=

# OpenAI API (optional, regex fallback by default)
OPENAI_API_KEY=
